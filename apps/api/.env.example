# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO CÁC THÀNH VIÊN TRONG NHÓM (.env.example)
# Khi clone dự án về, hãy copy file này thành file .env và điền thông tin thật
# ==============================================================================

PORT=5000

# Chuỗi kết nối Database PostgreSQL (Hỏi bạn phụ trách mục 4 để lấy link Neon chung của nhóm)
DATABASE_URL="postgresql://username:password@your-host-neon.tech/neondb?sslmode=require"

# Khóa bí mật JWT dùng để test đăng nhập
JWT_SECRET="aita_super_secret_jwt_key_2024_change_me_later"
