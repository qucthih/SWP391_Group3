PORT=5000

# Chuỗi kết nối MSSQL (Đổi sa và mật khẩu khớp với SQL Server của bạn)
# trustServerCertificate=true là bắt buộc để Prisma bỏ qua lỗi SSL certificate cục bộ
DATABASE_URL="sqlserver://localhost:1433;database=aita_db;user=sa;password=YourPassword123;trustServerCertificate=true"

JWT_SECRET="aita_super_secret_jwt_key_2024_change_me_later"
