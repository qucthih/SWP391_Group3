// ==============================================================================
// PRISMA SCHEMA CHO DỰ ÁN HỆ THỐNG TRỢ LÝ AITA-INTELLIGENT (SWP391 - 10 WEEKS)
// Cơ sở dữ liệu: Microsoft SQL Server (MSSQL) - Đồng bộ chuẩn hóa theo tài liệu SRS
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// HẰNG SỐ QUY ƯỚC TRONG HỆ THỐNG (MSSQL không hỗ trợ enum gốc, lưu dạng String)
// Role: "STUDENT" | "LECTURER" | "ADMIN"
// SubmissionStatus: "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. BẢNG USERS: Quản lý thông tin tài khoản người dùng
// ------------------------------------------------------------------------------
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?
  fullName     String
  role         String        @default("STUDENT") // STUDENT, LECTURER, ADMIN
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Quan hệ:
  classesLectured Class[]       @relation("LecturerClasses")
  enrollments     ClassMember[]
  submissions     Submission[]

  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. BẢNG CLASSES: Quản lý lớp học môn học
// ------------------------------------------------------------------------------
model Class {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  lecturerId  String
  lecturer    User          @relation("LecturerClasses", fields: [lecturerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Quan hệ:
  members     ClassMember[]
  exams       Exam[]

  @@map("classes")
}

// Bảng trung gian n-n: Sinh viên thuộc lớp nào
model ClassMember {
  id        String   @id @default(uuid())
  classId   String
  userId    String
  joinedAt  DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("class_members")
}

// ------------------------------------------------------------------------------
// 3. BẢNG EXAMS: Quản lý Đề thi / Bài tập thực hành
// ------------------------------------------------------------------------------
model Exam {
  id          String           @id @default(uuid())
  title       String
  description String
  classId     String
  startTime   DateTime
  endTime     DateTime
  maxScore    Float            @default(10.0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Quan hệ:
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions Submission[]
  criteria    CriterionScore[]

  @@map("exams")
}

// ------------------------------------------------------------------------------
// 4. BẢNG SUBMISSIONS: Quản lý bài nộp mã nguồn của sinh viên
// ------------------------------------------------------------------------------
model Submission {
  id              String           @id @default(uuid())
  examId          String
  studentId       String
  sourceCodeUrl   String
  status          String           @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalScore      Float?
  compileLog      String?
  submittedAt     DateTime         @default(now())

  // Quan hệ:
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fingerprints    ASTFingerprint[]
  ruleScores      RuleScore[]

  @@map("submissions")
}

// ------------------------------------------------------------------------------
// 5. BẢNG AST_FINGERPRINTS: Vân tay số cây AST (Trọng tâm RBL & Winnowing)
// ------------------------------------------------------------------------------
model ASTFingerprint {
  id            String     @id @default(uuid())
  submissionId  String
  hashValue     BigInt
  position      Int
  createdAt     DateTime   @default(now())

  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([hashValue])
  @@map("ast_fingerprints")
}

// ------------------------------------------------------------------------------
// 6. BẢNG RULE_SCORES: Kết quả kiểm tra Clean Code / Sandbox
// ------------------------------------------------------------------------------
model RuleScore {
  id           String     @id @default(uuid())
  submissionId String
  ruleName     String
  score        Float
  maxScore     Float
  feedback     String?
  createdAt    DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("rule_scores")
}

// ------------------------------------------------------------------------------
// 7. BẢNG CRITERION_SCORES: Barem tiêu chí chấm điểm
// ------------------------------------------------------------------------------
model CriterionScore {
  id          String   @id @default(uuid())
  examId      String
  name        String
  description String?
  weight      Float
  createdAt   DateTime @default(now())

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("criterion_scores")
}
